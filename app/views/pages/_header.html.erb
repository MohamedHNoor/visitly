<header class="marketing-header"
        data-controller="disclosure"
        data-action="keydown.esc->disclosure#close click@window->disclosure#closeOnOutsideClick">
  <%= link_to root_path, class: "inline-flex rounded-[10px]" do %>
    <%= image_tag "visitly-logo.svg", alt: "Visitly", width: 138, height: 36, class: "h-9 w-auto" %>
  <% end %>

  <nav aria-label="Main" class="marketing-nav">
    <a href="#features" class="marketing-nav-link">Features</a>
    <a href="#industries" class="marketing-nav-link">Who it’s for</a>
    <a href="#pricing" class="marketing-nav-link">Pricing</a>
    <%= link_to "Sign in", new_session_path, class: "marketing-login-link" %>
    <a href="<%= new_registration_path %>" class="btn">Start free trial</a>
  </nav>

  <button type="button"
          class="btn btn-secondary marketing-menu-toggle"
          aria-label="Open menu"
          aria-expanded="false"
          aria-controls="mobile-menu"
          data-disclosure-target="button"
          data-action="disclosure#toggle">
    <%= icon(:menu) %>
  </button>

  <nav id="mobile-menu"
       aria-label="Mobile"
       hidden
       class="marketing-mobile-menu"
       data-disclosure-target="panel">
    <a href="#features" class="marketing-mobile-link" data-action="disclosure#close">Features</a>
    <a href="#industries" class="marketing-mobile-link" data-action="disclosure#close">Who it’s for</a>
    <a href="#pricing" class="marketing-mobile-link" data-action="disclosure#close">Pricing</a>
    <%= link_to "Sign in", new_session_path, class: "marketing-mobile-link", data: { action: "disclosure#close" } %>
    <a href="<%= new_registration_path %>" class="btn mt-2" data-action="disclosure#close">Start free trial</a>
  </nav>
</header>
