<%# Plans: monthly NZD excluding GST. %>
<section id="pricing" class="section-anchor pb-12.5 md:pb-20" aria-labelledby="pricing-heading">
  <div class="marketing-section-intro">
    <p class="eyebrow">Room to grow</p>
    <h2 id="pricing-heading" class="marketing-section-heading">
      One clear price.<br> A whole lot less admin.
    </h2>
    <p class="text-muted">Every plan includes unlimited bookings and all features, with no booking fees. Choose the size that fits your team.</p>
  </div>

  <div class="marketing-three-column-grid">
    <% [
      { name: "Solo", price: 29, staff: "1 active bookable staff member" },
      { name: "Team", price: 49, staff: "Up to 5 active bookable staff", featured: true },
      { name: "Growth", price: 99, staff: "Unlimited active bookable staff" }
    ].each do |plan| %>
      <article class="marketing-pricing-card <%= plan[:featured] ? "marketing-pricing-featured" : "marketing-pricing-standard" %>">
        <div class="marketing-pricing-header">
          <h3 class="marketing-card-heading"><%= plan[:name] %></h3>
          <% if plan[:featured] %>
            <span class="marketing-pricing-badge">For growing teams</span>
          <% end %>
        </div>

        <p class="marketing-price">
          NZ$<%= plan[:price] %>
          <span class="marketing-price-period">/ month excl. GST</span>
        </p>
        <p class="mt-2.5 text-xs text-muted"><%= plan[:staff] %></p>

        <ul class="marketing-plan-benefits">
          <% [ "Unlimited bookings", "Recurring visit scheduling", "All features included", "No booking fees" ].each do |item| %>
            <li class="flex items-center gap-2"><%= icon(:check, css_class: "size-4 text-brand") %><%= item %></li>
          <% end %>
        </ul>
      </article>
    <% end %>
  </div>

  <p class="mt-4.5 text-xs text-muted">Prices are in New Zealand dollars and exclude GST. Start with a 30-day free trial. No card required.</p>
</section>
