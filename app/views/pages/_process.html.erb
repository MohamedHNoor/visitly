<section class="pb-12.5 md:pb-20" aria-labelledby="process-heading">
  <div class="mb-9 max-w-162.5">
    <p class="eyebrow">From setup to the next visit</p>
    <h2 id="process-heading" class="mb-4.5 mt-3 text-[32px] font-bold leading-[1.2] tracking-[-1.3px] md:text-[42px] md:tracking-[-1.8px]">
      Simple to start. Easy to keep going.
    </h2>
  </div>

  <ol class="grid gap-5 md:grid-cols-3">
    <% [
      [ "Make it yours", "Add your services, staff and working hours." ],
      [ "Share your booking page", "Let customers book with your business directly." ],
      [ "Keep the work moving", "Manage visits, reminders and recurring schedules." ]
    ].each.with_index(1) do |(title, body), number| %>
      <li class="rounded-[20px] border border-line bg-white p-5.5 lg:p-6.75">
        <span class="grid size-8.25 place-items-center rounded-[10px] bg-sage font-bold text-brand" aria-hidden="true"><%= number %></span>
        <h3 class="mt-5 text-[17px] font-bold tracking-[-0.3px]"><span class="sr-only">Step <%= number %>: </span><%= title %></h3>
        <p class="mt-3 text-[13px] leading-[1.75] text-muted"><%= body %></p>
      </li>
    <% end %>
  </ol>
</section>
