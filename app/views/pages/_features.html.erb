<section id="features" class="section-anchor py-12.5 md:py-20" aria-labelledby="features-heading">
  <div class="marketing-section-intro">
    <p class="eyebrow">A lighter workday</p>
    <h2 id="features-heading" class="marketing-section-heading">
      Your bookings, team and customers.<br class="hidden md:inline"> All on the same page.
    </h2>
    <p class="text-muted">Spend less time stitching together messages, calendars and spreadsheets. Make room for the work you do best.</p>
  </div>

  <div class="marketing-feature-grid">
    <% [
      [ :calendar, "Bookings without the back-and-forth", "Share your booking page. Let customers choose services and available times, while you stay in control." ],
      [ :repeat, "Regular work, reliably organised", "Set a weekly, fortnightly or four-weekly cadence. Manage skips, pauses and changes in one place." ],
      [ :users, "A schedule your team can trust", "Assign the right staff, protect availability and allow time to travel between visits." ],
      [ :mail, "Customers kept in the loop", "Send booking confirmations and email reminders, with secure links to manage visits." ],
      [ :pin, "The right details, at hand", "Keep property, vehicle and site requirements alongside each visit, ready for your team." ],
      [ :money, "Payments on your terms", "Collect payments your own way. Record receipts, refunds and outstanding balances in Visitly." ]
    ].each do |icon_name, title, body| %>
      <article class="marketing-card">
        <div class="service-mark mb-5.5"><%= icon(icon_name) %></div>
        <h3 class="marketing-card-heading"><%= title %></h3>
        <p class="marketing-card-description"><%= body %></p>
      </article>
    <% end %>
  </div>
</section>
