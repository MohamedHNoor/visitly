<section id="faq" class="section-anchor marketing-faq" aria-labelledby="faq-heading">
  <h2 id="faq-heading" class="marketing-faq-heading">A few things you might be wondering.</h2>

  <% [
    [ "Do my customers pay through Visitly?",
      "You collect service payments using your own arrangements. Visitly lets you manually record receipts, refunds and balances. Your Visitly subscription is separate." ],
    [ "Can I schedule recurring visits?",
      "Yes. Set weekly, fortnightly or every-four-week schedules. Skip or pause visits without shifting the cadence." ],
    [ "What happens after the free trial?",
      "Your 30-day trial needs no card. Choose a paid plan before it ends to keep taking bookings. If you don’t subscribe, your workspace becomes read-only for seven days: you can view and export your records, but you can’t take new bookings, change visits or generate recurring visits. For the following seven days you can only download or delete your data. Unpaid workspaces are then deleted, 14 days after the trial ends, and we’ll let you know beforehand. Confirmed visits are never automatically cancelled." ],
    [ "Is Visitly available outside New Zealand?",
      "Visitly is designed for New Zealand businesses at launch. Australian support is outside the initial scope." ]
  ].each do |question, answer| %>
    <details class="group border-b border-line py-5.5">
      <summary class="marketing-faq-question">
        <%= question %>
        <svg class="icon marketing-faq-chevron" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M6 9l6 6 6-6"/></svg>
      </summary>
      <p class="mt-3.75 text-muted"><%= answer %></p>
    </details>
  <% end %>
</section>
