<section class="marketing-hero" aria-labelledby="hero-heading">
  <div>
    <p class="eyebrow">For New Zealand mobile service businesses</p>
    <h1 id="hero-heading" class="marketing-hero-heading">
      Less admin.<br>
      <span class="text-brand">More happy<br>customers.</span>
    </h1>
    <p class="marketing-hero-description">
      The booking and scheduling home for residential cleaning and mobile car detailing businesses.
    </p>
    <div class="marketing-hero-actions">
      <a href="<%= new_registration_path %>" class="btn min-h-12">Start your 30-day trial</a>
    </div>
    <p class="marketing-trial-note">
      <%= icon(:check, css_class: "text-brand") %>
      No card required. No booking fees.
    </p>
  </div>

  <%# Decorative product illustration with fictional sample visits. %>
  <div class="marketing-preview" aria-hidden="true">
    <div class="marketing-preview-ring"></div>

    <div class="marketing-preview-card">
      <div class="marketing-preview-header">
        <div>
          <span class="eyebrow">Monday, 12 October</span>
          <p class="marketing-preview-heading">A good day, already planned.</p>
        </div>
        <span class="marketing-preview-avatar">MC</span>
      </div>

      <% [
        [ "09:00", :home, "Sarah Wilson", "Fortnightly home clean" ],
        [ "11:30", :car, "James Taylor", "Interior & exterior detail" ],
        [ "14:00", :home, "Emma Brown", "Weekly home clean" ]
      ].each do |time, kind, name, service| %>
        <div class="marketing-preview-row">
          <span class="marketing-preview-time"><%= time %></span>
          <span class="service-mark hidden lg:grid <%= "service-mark-detail" if kind == :car %>"><%= icon(kind) %></span>
          <span class="flex-1">
            <strong class="marketing-preview-service-name"><%= name %></strong>
            <span class="marketing-preview-service-description"><%= service %></span>
          </span>
          <span class="marketing-preview-status">Confirmed</span>
        </div>
      <% end %>

      <div class="marketing-preview-footer">
        <span class="text-muted">3 visits · 2 team members</span>
        <span class="text-brand">View your week →</span>
      </div>
    </div>

    <div class="marketing-preview-reminder">
      <%= icon(:repeat) %>
      Next fortnight? Already organised.
    </div>
  </div>
</section>

<div class="marketing-value-strip">
  <span>Built for work at your customer’s door</span>
  <span>NZD pricing · Your own booking page</span>
  <span>Your business. Your customer relationships.</span>
</div>
