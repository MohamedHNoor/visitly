<section id="industries" class="section-anchor pb-12.5 md:pb-20" aria-labelledby="industries-heading">
  <div class="marketing-section-intro">
    <p class="eyebrow">Made for your kind of work</p>
    <h2 id="industries-heading" class="marketing-section-heading">
      Different services.<br> The same calmer schedule.
    </h2>
  </div>

  <div class="marketing-industry-grid">
    <% [
      [ :home, "Residential cleaning", "Build dependable recurring work, with property details and clear staff assignments at every visit.",
        [ "First-visit and regular-clean pricing", "Weekly, fortnightly and four-weekly visits", "Secure property and access information" ] ],
      [ :car, "Mobile car detailing", "Bring the right service to the right vehicle, with site requirements and weather changes kept organised.",
        [ "Vehicle category and service selection", "Parking, water and power requirements", "Customer-approved alternative times" ] ]
    ].each do |icon_name, title, body, points| %>
      <article class="marketing-industry-card <%= icon_name == :car ? "bg-detail" : "bg-sage" %>">
        <div class="service-mark bg-white/60 <%= "text-detail-ink" if icon_name == :car %>"><%= icon(icon_name) %></div>
        <h3 class="marketing-industry-heading"><%= title %></h3>
        <p class="max-w-107.5 text-muted"><%= body %></p>
        <ul class="marketing-industry-points">
          <% points.each do |point| %>
            <li><%= point %></li>
          <% end %>
        </ul>
      </article>
    <% end %>
  </div>
</section>
