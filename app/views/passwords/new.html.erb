<%= render "shared/authentication_shell", title: "Let’s get you back in." do %>
  <p class="mt-3">Enter your email to request a password reset link.</p>
  <%= render "shared/authentication_feedback" %>
  <%= form_with url: passwords_path, class: "mt-6 grid gap-3" do |form| %>
    <%= form.label :email_address, "Email address" %>
    <%= form.email_field :email_address, value: params[:email_address], required: true, autocomplete: "email", class: "rounded-lg border border-line bg-white p-3" %>
    <%= form.submit "Send reset link", class: "btn mt-3", data: { turbo_submits_with: "Sending…" } %>
  <% end %>
  <%= link_to "Back to sign in", new_session_path, class: "mt-6 inline-block underline" %>
<% end %>
