<% %i[password password_confirmation].each do |field| %>
  <% hint_id = "password-hint" if field == :password %>
  <% describedby = [ hint_id, ("#{field}-error" if record.errors[field].any?) ].compact.join(" ").presence %>
  <div class="auth-field">
  <%= form.label field, field == :password_confirmation ? "Confirm password" : "Password" %>
  <%= render layout: "shared/password_input", locals: { input_id: form.field_id(field) } do %>
    <%= form.password_field field, required: true, autocomplete: "new-password", minlength: (User::MINIMUM_PASSWORD_LENGTH if field == :password), maxlength: 72, class: "auth-input", aria: { invalid: record.errors[field].any?, describedby: describedby }, data: { password_visibility_target: "input" } %>
  <% end %>
  <% if hint_id %><p class="auth-field-hint" id="<%= hint_id %>">At least <%= User::MINIMUM_PASSWORD_LENGTH %> characters, including a number and a special character such as ! ? # or -.</p><% end %>
  <% if record.errors[field].any? %><p class="auth-field-error" id="<%= field %>-error"><%= record.errors[field].join(", ") %></p><% end %>
  </div>
<% end %>
