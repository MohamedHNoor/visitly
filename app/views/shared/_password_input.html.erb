<%# Wraps a password field (passed as the block) with a show/hide toggle. %>
<div class="password-input" data-controller="password-visibility">
  <%= yield %>
  <button type="button" class="password-toggle" hidden aria-label="Show password" aria-pressed="false" aria-controls="<%= input_id %>"
          data-password-visibility-target="button" data-action="password-visibility#toggle">
    <span data-password-visibility-target="showIcon"><%= icon(:eye) %></span>
    <span data-password-visibility-target="hideIcon" hidden><%= icon(:eye_off) %></span>
  </button>
</div>
